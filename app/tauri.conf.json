{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FutureShell",
  "version": "1.0.0",
  "identifier": "io.futureshell.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      { "title": "FutureShell", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "FutureShell",
    "homepage": "https://github.com/BerryWang1996/future-shell",
    "category": "DeveloperTool",
    "shortDescription": "支持 SSH/SFTP、RDP 与串口的桌面终端工具",
    "longDescription": "支持 SSH/SFTP、RDP 与串口的桌面终端工具，采用 Rust、Tauri 2、Svelte 5 和 xterm.js。",
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "languages": ["SimpChinese", "English"] } },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libdbus-1-3"] } },
    "resources": [
      "THIRD_PARTY_NOTICES.html",
      "THIRD_PARTY_NOTICES.rdp.html",
      "THIRD_PARTY_NOTICES.npm.md"
    ],
    "externalBin": ["binaries/fs-rdp-helper"]
  }
}
